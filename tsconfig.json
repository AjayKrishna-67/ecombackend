{
  "compilerOptions": {
    "jsx": "react",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "target": "es2019",
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@vendure/dashboard/plugin": ["./node_modules/@vendure/dashboard/dist/plugin"],
      "@vendure/dashboard/vite": ["./node_modules/@vendure/dashboard/dist/vite"]
    }
  },
  "include": [
    "src/**/*.ts",
    "node_modules/otplib"
, "static/test/real-e2e-test.ts"  ],
  "exclude": [
    "node_modules",
    "migration.ts",
    "src/plugins/**/ui/**",
    "admin-ui",
 "src/plugins/**/dashboard/*",
        "src/gql/*",
        "vite.*.*ts"  ],
        "references": [
        {
            "path": "./tsconfig.dashboard.json"
        }
    ],
  "ts-node": {
    "files": true
  }
}