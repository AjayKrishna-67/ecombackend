# SHIPROCKET_EMAIL=change_me
# SHIPROCKET_PASSWORD=change_me

SHIPROCKET_EMAIL=change_me
SHIPROCKET_PASSWORD=change_me

# Adloggs hyperlocal delivery (dev host + dev key; switch to https://app.adloggs.com + live key for production)
ADLOGGS_HOST=https://app.adloggs.com
ADLOGGS_API_KEY=change_me
# Shared secret Adloggs must send in the x-webhook-token header of status webhooks.
# Give this value + the webhook URL (https://<api-host>/adloggs/webhook) to the Adloggs team.
ADLOGGS_WEBHOOK_TOKEN=change_me


GOOGLE_CLIENT_ID=change_me
ANTHROPIC_API_KEY=change_me

# Apple Sign In - one clientId per brand/app (Bundle ID for iOS, Service ID for web)
APPLE_CLIENT_ID_SOUTHMITHAI=com.kaaikani.kaaikani
APPLE_CLIENT_ID_SWADKERALA=com.Swadkerala.Swadkerala
APPLE_CLIENT_ID_KAAIKANIDIRECT=com.kaaikanidirect.kaaikanidirect
APPLE_CLIENT_ID_SIPNNOURISH=com.sipnnourish.sipnnourish

APPLE_CLIENT_ID_DEFAULT=com.kaaikani.kaaikani


DASHBOARD_API_HOST=http://localhost
DASHBOARD_API_PORT=80



# Abandoned-cart sweep interval (minutes). TESTING=1; set to 30 for production.
ABANDONED_CART_SWEEP_EVERY_MIN=30

MSG91_AUTH_KEY=change_me
MSG91_HELLO_NUMBER=919840089302

APPLE_CLIENT_ID_KAAIKANIDIRECT=com.kaaikanidirect.kaaikanidirect
APPLE_CLIENT_ID_SIPNNOURISH=com.sipnnourish.sipnnourish

# ─── Smartflo (Tata Tele) telephony ───
SMARTFLO_API_BASE_URL=https://api-smartflo.tatateleservices.com
# Portal-generated API token (API Connect → API Tokens)
SMARTFLO_API_TOKEN=change_me
KAAIKANI_TOKEN=change_me
# Shared secret Vendure expects in Authorization: Bearer header on webhook + dialplan callbacks
SMARTFLO_WEBHOOK_SECRET=
# Click-to-Call API keys — one per use case (API Connect → Click to Call Support API)
SMARTFLO_C2C_KEY_SUPPORT=change_me
SMARTFLO_C2C_KEY_DELIVERY=change_me

# Default outbound caller-ID DIDs per Click-to-Call type
SMARTFLO_DID_SUPPORT=918065489020
SMARTFLO_DID_DELIVERY=918065489020

# Google Maps JS API key (GCP) for the admin store-location map picker (Take Away plugin)
GOOGLE_MAPS_API_KEY=

# Local dev: point the dashboard at the local server (defaults to production when unset)
DASHBOARD_API_HOST=http://localhost
DASHBOARD_API_PORT=3001

MSG91_HELLO_NUMBER=919840089302

# Customer live-tracking road route (Google Routes API). Prefer a dedicated
# server key; otherwise the browser key + an allowed referer origin works.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_KEY_REFERER=

# WhatsApp auto-reply (WhatsappPlugin). Meta webhook URL: https://<host>/whatsapp/webhook
# WA_PHONE_ID      = Meta App > WhatsApp > API Setup > Phone number ID
# WA_TOKEN         = permanent system-user token with whatsapp_business_messaging
# WA_VERIFY_TOKEN  = any string; must match "Verify token" in Meta webhook settings
# WA_APP_SECRET    = Meta App > App settings > Basic > App secret (signs webhooks)
# STORE_URL        = link opened by the "Order now" button
WA_PHONE_ID=
WA_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Whose wording, city list and invoice the bot uses: kaaikani | star-biryani (see whatsapp/brands.ts)
WA_BRAND=
# Comma-separated tester numbers (e.g. 918525876381). While set, the bot replies ONLY to them — keep it set until launch.
WA_TEST_NUMBERS=
STORE_URL=https://www.amburstarbriyani.com/home

# Placeholder email for phone-only accounts (SMS OTP / WhatsApp login) — server-wide,
# one value per deployment. Must be a domain the brand OWNS: order emails go to it.
# Unset = kaikani.com. Star Biriyani deployment: amburstarbriyani.com
PLACEHOLDER_EMAIL_DOMAIN=
