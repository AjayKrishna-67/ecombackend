{
  "name": "ecombackend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node ./src/index.ts",
    "dev:worker": "ts-node ./src/index-worker.ts",
    "predev": "pkill -f 'node_modules/.bin/[v]ite' || true",
    "dev": "concurrently \"npm:dev:*\"",
    "fresh": "pkill -9 -f vite || true; pkill -9 -f concurrently || true; rm -rf node_modules/.vite; bun run dev",
    "start:server": "node ./dist/src/index.js",
    "start:worker": "node ./dist/src/index-worker.js",
    "start": "concurrently \"npm:start:*\"",
    "copy": "npx copyfiles 'admin-ui/dist/**/*' dist && npx copyfiles 'src/assets/**/*' dist && npx copyfiles 'static/**/*' dist",
    "build": "tsc && npm run copy",
    "build:admin": "rimraf admin-ui && npx ts-node src/compile-admin-ui.ts",
    "build:dashboard": "vite build",
    "dev:dashboard": "vite",
    "codegen": "graphql-codegen --config codegen.ts",
    "migration:generate": "ts-node ./migrate.ts generate",
    "migration:run": "ts-node ./migrate.ts run",
    "migration:revert": "ts-node ./migrate.ts revert",
    "test": "vitest run --config vitest.unit.config.mts",
    "test:watch": "vitest --config vitest.unit.config.mts",
    "test:ui": "vitest --ui --config vitest.unit.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.mts",
    "//test:report": "The vitest HTML reporter fetches a gzipped metadata file, so it must be served over HTTP — opening reports/unit/index.html from the filesystem shows an empty page.",
    "test:report": "vite preview --outDir ./reports/unit",
    "test:coverage:report": "vite preview --outDir ./reports/coverage",
    "//test:e2e": "Boots a real Vendure server on sql.js. Set LOG=true to see server logs when a suite fails for a non-obvious reason.",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.mts",
    "test:all": "bun run test && bun run test:e2e",
    "//test:pw": "Browser tests. Requires `bun run dev` to already be running — Playwright deliberately does not start the app. Override the URL with PW_BASE_URL.",
    "test:pw": "playwright test",
    "test:pw:ui": "playwright test --ui",
    "test:pw:headed": "playwright test --headed",
    "test:pw:report": "playwright show-report reports/playwright",
    "test:smoke": "bash src/plugins/Essentials/channel-availability/smoke-test.sh",
    "//test:dashboard": "vitest.config.mts loads the @vendure/dashboard vite plugin and roots into the dashboard package (its own browser specs need jsdom) — NOT the project's backend tests. Kept only for dashboard-extension work.",
    "test:dashboard": "vitest run --config vitest.config.mts",
    "main": "dist/index.js",
    "type": "module"
    
  },
