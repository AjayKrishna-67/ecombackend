{{> header title="Order Delivered - South Mithai" brand=brand }}

<mj-raw>
    <style type="text/css">
    .callout {
        background-color: {{ brand.primaryColor }};
        padding: 15px 0;
    }
    ul.address {
        list-style-type: none;
        padding: 0;
    }
    tr.order-row td {
        border-bottom: 1px dashed #eee;
    }
    tr.order-row td:last-child {
        text-align: center;
    }
    tr.total-row {
        font-weight: bold;
    }
    .bg-off-white {
        background-color: #f5f5f5;
    }
    </style>
</mj-raw>

<mj-section background-color="{{ brand.backgroundColor }}">
    <mj-column>
        <mj-text>
            Dear {{ order.customer.firstName }} {{ order.customer.lastName }},
        </mj-text>
        <mj-text>
            Great news! Your order has been successfully delivered.
        </mj-text>
        <mj-text>
            We hope you enjoy your {{ brand.name }} treats! If you have any questions or feedback, please don't hesitate to contact us.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section css-class="callout">
    <mj-column>
        <mj-text ><strong>Order Code</strong></mj-text>
        <mj-text >{{ order.code }}</mj-text>
    </mj-column>
    <mj-column>
        <mj-text ><strong>Order Date</strong></mj-text>
        <mj-text >{{ formatDate order.orderPlacedAt }}</mj-text>
    </mj-column>
    <mj-column>
        <mj-text ><strong>Total Price</strong></mj-text>
        <mj-text >{{ currencySymbol }}{{ formatMoney order.totalWithTax }}</mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="{{ brand.backgroundColor }}">
    <mj-column>
        <mj-text>
            {{#with order.shippingAddress }}
                <h3>Delivered To:</h3>
                <ul class="address">
                    {{#if company}}<li>{{ company }}</li>{{/if}}<br/>
                    {{#if streetLine1}}<li>{{ streetLine1 }}</li>{{/if}}<br/>
                    {{#if streetLine2}}<li>{{ streetLine2 }}</li>{{/if}}<br/>
                    {{#if city}}<li>{{ city }}</li>{{/if}}<br/>
                    {{#if postalCode}}<li>{{ postalCode }}</li>{{/if}}<br/>
                    {{#if country}}<li>{{ country }}</li>{{/if}}<br/>
                    {{#if phoneNumber}}<li>{{ phoneNumber }}</li>{{/if}}
                </ul>
            {{/with}}
        </mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="{{ brand.backgroundColor }}">
    <mj-column>
        <mj-text>
            <h3>Delivered Order Summary:</h3>
        </mj-text>
        <mj-table cellpadding="6px">
            {{#each order.lines }}
                <tr class="order-row">
                    <td colspan="2">{{ quantity }} x {{ productVariant.name }}</td>
                    <td>{{ ../currencySymbol }}{{ formatMoney discountedLinePriceWithTax }}</td>
                </tr>
            {{/each}}
            <tr class="order-row">
                <td colspan="2">Sub-total:</td>
                <td>{{ currencySymbol }}{{ formatMoney order.subTotalBeforeDiscount }}</td>
            </tr>
            {{#if showTax}}
            <tr class="order-row">
                <td colspan="2">Tax:</td>
                <td>{{ currencySymbol }}{{ formatMoney taxTotal }}</td>
            </tr>
            {{/if}}
            <tr class="order-row">
                <td colspan="2">Shipping:</td>
                <td>{{ currencySymbol }}{{ formatMoney order.shipping }}</td>
            </tr>
            {{#each order.discounts }}
            <tr class="order-row">
                <td colspan="2">Discount ({{ description }}):</td>
                <td>-{{ ../currencySymbol }}{{ formatMoney amount }}</td>
            </tr>
            {{/each}}
            <tr class="order-row total-row">
                <td colspan="2">Total:</td>
                <td>{{ currencySymbol }}{{ formatMoney order.totalWithTax }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<mj-section background-color="{{ brand.backgroundColor }}">
    <mj-column>
        <mj-text color="#525252">
            <strong>Payment Information:</strong><br/>
            {{#each order.payments }}
                Payment Method: {{ method }}<br/>
                Amount: {{ ../currencySymbol }}{{ formatMoney amount }}
            {{/each}}
        </mj-text>
    </mj-column>
</mj-section>

<mj-section background-color="{{ brand.backgroundColor }}">
    <mj-column>
        <mj-text color="#525252">
            <strong>Thank you for choosing {{ brand.name }}!</strong><br/>
            We hope you enjoyed your order and look forward to serving you again soon.
        </mj-text>
        <mj-text color="#525252">
            <strong>Rate Your Experience:</strong><br/>
            We'd love to hear about your experience! Your feedback helps us improve our service.
        </mj-text>
        <mj-button font-family="Helvetica"
                   background-color="{{ brand.ctaColor }}"
                   color="white"
                   href="{{ shopUrl }}">
            Shop Again
        </mj-button>
    </mj-column>
</mj-section>

{{> footer brand=brand }}
