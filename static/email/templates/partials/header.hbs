<mjml>
    <mj-head>
        <mj-title>{{ title }}</mj-title>
        <mj-style inline="inline">
            h3 {
                font-size: 18px;
                color: #555;
                font-weight: normal;
            }
            .header-logo {
                font-size: 35px;
                font-weight: bold;
                color: {{#if brand}}{{brand.textOnPrimary}}{{else}}#ffffff{{/if}};
            }
            .main-content {
                background-color: {{#if brand}}{{brand.backgroundColor}}{{else}}#ffedc7{{/if}};
            }
        </mj-style>
    </mj-head>

    <mj-body>
        <mj-section background-color="{{#if brand}}{{brand.primaryColor}}{{else}}#92400e{{/if}}" padding="20px 0">
            <mj-column>
                <mj-image src="{{#if brand}}{{brand.logoUrl}}{{else}}https://s3.ap-south-1.amazonaws.com/cdn.kaaikani.co.in/southmithai.png{{/if}}" 
                         alt="{{#if brand}}{{#if brand.logoAlt}}{{brand.logoAlt}}{{else}}{{brand.name}} Logo{{/if}}{{else}}South Mithai Logo{{/if}}" 
                         width="{{#if brand}}{{brand.logoWidth}}{{else}}150px{{/if}}" 
                         align="center" 
                         padding="0 0 10px 0" />
            </mj-column>
        </mj-section>
